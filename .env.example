# Backend environment variables (FastAPI + legacy modules)
# Copy this file to `.env` and fill in values.

# Gemini API key used by extraction code.
# Either `GEMINI_API_KEY` or `GOOGLE_API_KEY` works.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Pinned LLM model used by both direct Gemini calls and LangChain extraction chains.
# Keep this explicit to avoid silent behavior changes from model alias drift.
GOA_LLM_MODEL=gemini-2.5-flash-lite

# Two-pass extraction models (V2 full prefill pipeline).
GOA_LLM_MODEL_DRAFT=gemini-2.5-flash-lite
GOA_LLM_MODEL_DEEP=gemini-2.5-flash

# Optional override for semantic few-shot embedding model.
# Defaults to a fallback list that starts with `models/text-embedding-004`.
FEW_SHOT_EMBEDDING_MODEL=

# Emergency switch only: set to true to disable all few-shot prompt augmentation.
# DISABLE_ALL_FEW_SHOT=false

# V2 full-prefill rollout flag
EXTRACTION_FULL_PREFILL_V2_ENABLED=false

# Pass-level budgets for V2 full prefill pipeline
LLM_PASS1_RAG_MAX_CHARS=12000
LLM_PASS2_RAG_MAX_CHARS=22000
LLM_PASS1_GROUP_MAX_FIELDS=60
LLM_PASS2_GROUP_MAX_FIELDS=35
LLM_EXTRACTION_MAX_CONCURRENCY=3
LLM_EXTRACTION_MAX_CONCURRENCY_PER_USER=1

# V2 RAG/critical-text quality controls
LLM_RAG_WEIGHTED_HINTS_ENABLED=true
LLM_CRITICAL_TEXT_RESOLVER_ENABLED=true
LLM_FORCE_PASS2_CRITICAL_TEXT=true
LLM_CRITICAL_TEXT_TAGS=direction,voltage,hz,phases

# SQLite database file path (inside repo for local dev).
DATABASE_PATH=data/crm_data.db

# Comma-separated list of frontend origins allowed by CORS middleware.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth (Phase 1)
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_SESSION_TTL_HOURS=12
AUTH_COOKIE_NAME=goa_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_PEPPER=

# Per-user Gemini key encryption (Phase 2)
GEMINI_KEY_ENCRYPTION_SECRET=

# Optional QUOTE_LIBRARY overrides used during machine extraction.
# QUOTE_LIBRARY_PATH=QUOTE_LIBRARY.txt
# QUOTE_LIBRARY_MAX_SECTIONS=2
# QUOTE_LIBRARY_MAX_CHARS=14000
