# Backend environment variables (FastAPI + legacy modules)
# Copy this file to `.env` and fill in values.

# Gemini API key used by extraction code.
# Either `GEMINI_API_KEY` or `GOOGLE_API_KEY` works.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Pinned LLM model used by both direct Gemini calls and LangChain extraction chains.
# Keep this explicit to avoid silent behavior changes from model alias drift.
GOA_LLM_MODEL=gemini-2.5-flash-lite

# Optional override for semantic few-shot embedding model.
# Defaults to a fallback list that starts with `models/text-embedding-004`.
FEW_SHOT_EMBEDDING_MODEL=

# Emergency switch only: set to true to disable all few-shot prompt augmentation.
# DISABLE_ALL_FEW_SHOT=false

# SQLite database file path (inside repo for local dev).
DATABASE_PATH=data/crm_data.db

# Comma-separated list of frontend origins allowed by CORS middleware.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional QUOTE_LIBRARY overrides used during machine extraction.
# QUOTE_LIBRARY_PATH=QUOTE_LIBRARY.txt
# QUOTE_LIBRARY_MAX_SECTIONS=2
# QUOTE_LIBRARY_MAX_CHARS=14000
